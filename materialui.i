            (f & PACE_FACT_NONBLOCKING) != 0,
            (f & PACE_FACT_FASTMOTION) != 0,
            (f & PACE_FACT_SCANLINE_SYNC) != 0,
            (f & PACE_FACT_RATE_CONTROL) != 0))
      pace |= RUNLOOP_PACE_TIMER;
   return pace;
}


