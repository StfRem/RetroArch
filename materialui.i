static __inline _Bool string_is_empty(const char *data)
{
   return !data || !*data;
}

static __inline _Bool string_is_equal(const char *a, const char *b)
{
   if (a == b)
      return 1;
   if (!a || !b)
      return 0;
   return !strcmp(a, b);
}

static __inline _Bool string_starts_with_size(const char *str, const char *prefix,
      size_t len)
{
   return (str && prefix) ? !strncmp(prefix, str, len) : 0;
}

static __inline _Bool string_starts_with(const char *str, const char *prefix)
{
   return (str && prefix) ? !strncmp(prefix, str, strlen(prefix)) : 0;
}

static __inline _Bool string_ends_with_size(const char *s, const char *suffix,
      size_t len, size_t suffix_len)
{
   return (len < suffix_len) ? 0 :
         !memcmp(suffix, s + (len - suffix_len), suffix_len);
}

static __inline _Bool string_ends_with(const char *s, const char *suffix)
{
   return s && suffix && string_ends_with_size(s, suffix, strlen(s), strlen(suffix));
}
