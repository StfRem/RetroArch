static __inline int64_t runloop_content_frame_time_ns(float core_hz)
{
   int64_t period = (core_hz > 0.0f)
         ? (int64_t)(1000000000.0 / (double)core_hz) : 16666667;
   if (period < 1000000)
      return 1000000;
   if (period > 100000000)
      return 100000000;
   return period;
}
