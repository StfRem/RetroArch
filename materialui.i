static __inline retro_time_t runloop_content_frame_time_us(float core_hz)
{
   retro_time_t period = (core_hz > 0.0f)
         ? (retro_time_t)(1000000.0f / core_hz) : 16667;
   if (period < 1000)
      return 1000;
   if (period > 100000)
