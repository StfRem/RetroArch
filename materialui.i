static __inline float video_driver_aspect_ratio_of(
      const retro_atomic_int_t *bits)
{
   union { int i; float f; } u;
   u.i = __c11_atomic_load(((retro_atomic_int_t*)bits), memory_order_acquire);
   return u.f;
}

static __inline void video_driver_aspect_ratio_put(
      retro_atomic_int_t *bits, float aspect)
{
   union { int i; float f; } u;
   u.f = aspect;
   __c11_atomic_store((bits), (u.i), memory_order_release);
}
