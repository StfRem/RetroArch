                    && !display_paces)
                || (!display_paces && !menu_content
                    && (f & PACE_FACT_MENU_ALIVE)
                    && ( !(f & PACE_FACT_VSYNC) || !(f & PACE_FACT_FOCUSED)
                        || ( (f & PACE_FACT_MENU_DISPLAY_RATE)
