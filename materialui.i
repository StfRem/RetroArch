typedef struct task_notify
{
   retro_task_callback_t cb;
   void *user_data;
} task_notify_t;



static __inline void task_notify_fire(task_notify_t *n, void *task_data,
      const char *error)
{
   retro_task_callback_t cb = n->cb;
   n->cb = ((void*)0);
   if (cb)
      cb(((void*)0), task_data, n->user_data, error);
}



static __inline void task_notify_set(task_notify_t *n,
      retro_task_callback_t cb, void *user_data)
{
   task_notify_fire(n, ((void*)0), "Superseded by another request.");
   n->cb = cb;
   n->user_data = user_data;
}
