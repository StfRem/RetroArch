   return i;
}

static __inline _Bool string_is_equal_case_insensitive(const char *a,
      const char *b)
{
   int result = 0;
   const unsigned char *p1 = (const unsigned char*)a;
   const unsigned char *p2 = (const unsigned char*)b;

   if (!a || !b)
      return 0;
   if (p1 == p2)
      return 1;

   while ((result = tolower (*p1) - tolower (*p2++)) == 0)
      if (*p1++ == '\0')
         break;

   return (result == 0);
}

static __inline _Bool string_starts_with_case_insensitive(const char *str,
      const char *prefix)
{
   int result = 0;
   const unsigned char *p1 = (const unsigned char*)str;
   const unsigned char *p2 = (const unsigned char*)prefix;

   if (!str || !prefix)
      return 0;
   if (p1 == p2)
      return 1;

   while ((result = tolower (*p1++) - tolower (*p2)) == 0)
      if (*p2++ == '\0')
         break;

   return (result == 0 || *p2 == '\0');
}

