typedef struct audio_pipeline_layout
{
   retro_atomic_size_t head;
   unsigned published_layout;
   uint32_t published_control, published_cutoff;
   uint8_t producer_pad[56];
   retro_atomic_size_t tail;
   unsigned current_layout;
   uint32_t current_control, reset_serial, current_cutoff;
   uint8_t consumer_pad[52];
   struct { size_t position; unsigned layout; uint32_t control, cutoff; } events[64];
} audio_pipeline_layout_t;


static __inline void audio_pipeline_layout_init(audio_pipeline_layout_t *q,
      unsigned layout)
{
   __c11_atomic_init((&q->head), (0));
   __c11_atomic_init((&q->tail), (0));
   q->published_layout = q->current_layout = layout;
   q->published_control = q->current_control = 65536;
   q->reset_serial = 0;
   q->published_cutoff = q->current_cutoff = 0;
}


static __inline _Bool audio_pipeline_layout_event(audio_pipeline_layout_t *q,
      size_t position, unsigned layout, uint32_t control)
{
   size_t head = __c11_atomic_load((&q->head), memory_order_relaxed);
   size_t tail = __c11_atomic_load((&q->tail), memory_order_acquire);
   size_t slot;
   if (head - tail == 64) return 0;
   slot = head & (64 - 1);
   q->events[slot].position = position;
   q->events[slot].layout = layout;
   q->events[slot].control = control;
   q->events[slot].cutoff = q->published_cutoff;
   q->published_layout = layout;
   q->published_control = control & ~(0x80000000U);
   __c11_atomic_store((&q->head), (head + 1), memory_order_release);
   return 1;
}




static __inline _Bool audio_pipeline_layout_publish_cutoff(
      audio_pipeline_layout_t *q, size_t position, uint32_t cutoff)
{
   uint32_t previous = q->published_cutoff;
   if (cutoff == previous) return 1;
   q->published_cutoff = cutoff;
   if (audio_pipeline_layout_event(q, position,
            q->published_layout, q->published_control)) return 1;
   q->published_cutoff = previous;
   return 0;
}




static __inline _Bool audio_pipeline_layout_publish(audio_pipeline_layout_t *q,
      size_t position, unsigned layout)
{
   if (layout == q->published_layout) return 1;
   return audio_pipeline_layout_event(q, position, layout, q->published_control);
}






static __inline _Bool audio_pipeline_layout_publish_processing(
      audio_pipeline_layout_t *q, size_t position, unsigned layout,
      uint32_t tempo_q16, _Bool active, _Bool reset, uint32_t cutoff)
{
   uint32_t control = 65536;
   uint32_t previous = q->published_cutoff;
   if (active)
   {
      if (tempo_q16 < 16384 || tempo_q16 > 2097152) return 0;
      control = tempo_q16 | (0x00400000U);
   }
   if (!reset && layout == q->published_layout && control == q->published_control
         && cutoff == previous)
      return 1;
   if (reset) control |= (0x80000000U);
   q->published_cutoff = cutoff;
   if (audio_pipeline_layout_event(q, position, layout, control)) return 1;
   q->published_cutoff = previous;
   return 0;
}


static __inline _Bool audio_pipeline_layout_publish_transport(
      audio_pipeline_layout_t *q, size_t position, unsigned layout,
      uint32_t tempo_q16, _Bool active, _Bool reset)
{
   return audio_pipeline_layout_publish_processing(q, position, layout,
         tempo_q16, active, reset, q->published_cutoff);
}






static __inline size_t audio_pipeline_layout_limit_impl(audio_pipeline_layout_t *q,
      size_t position, size_t bytes, size_t capacity, _Bool transport)
{
   size_t tail = __c11_atomic_load((&q->tail), memory_order_relaxed);
   size_t head = __c11_atomic_load((&q->head), memory_order_acquire);
   size_t first = tail;
   while (tail != head)
   {
      size_t slot = tail & (64 - 1);
      size_t distance = q->events[slot].position - position;
      if (distance && distance <= capacity)
      {
         if (bytes > distance) bytes = distance;
         break;
      }
      q->current_layout = q->events[slot].layout;
      if (transport)
      {
         q->current_control = q->events[slot].control & ~(0x80000000U);
         q->current_cutoff = q->events[slot].cutoff;
         if (q->events[slot].control & (0x80000000U)) q->reset_serial++;
      }
      tail++;
   }
   if (tail != first) __c11_atomic_store((&q->tail), (tail), memory_order_release);
   return bytes;
}


static __inline size_t audio_pipeline_layout_limit(audio_pipeline_layout_t *q,
      size_t position, size_t bytes, size_t capacity)
{
   return audio_pipeline_layout_limit_impl(q, position, bytes, capacity, 0);
