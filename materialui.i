            gfx_animation_ticker(&mui->ticker);







            entry_value_width = (entry_value_len + 1) * glyph_width;

            entry_value_color = (entry_selected || touch_feedback_active)
                  ? mui->colors.list_text_highlighted : mui->colors.list_text;


