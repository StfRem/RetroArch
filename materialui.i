            ((((unsigned)((unsigned)node->entry_width) > 0xffffu ? 0xffffu : (unsigned)((unsigned)node->entry_width)) << 16) | ((unsigned)(mui->entry_divider_width) > 0xffffu ? 0xffffu : (unsigned)(mui->entry_divider_width))),

